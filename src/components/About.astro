---
/**
 * About Section Component
 * 
 * Clean biographical content with emphasized place names.
 */
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
---

<Section id="about">
  <SectionTitle>About me</SectionTitle>
  <div class="prose prose-lg max-w-none text-muted-foreground">
    <p class="leading-relaxed">
      I'm curious about how people think, behave, and relate to the world around them, and how technology can help us better understand these experiences.
    </p>
    <p class="mt-6 leading-relaxed">
      My work brings together psychology, research, data analysis, and digital development. I enjoy exploring ideas across disciplines, building practical solutions, and finding ways to make knowledge more useful, accessible, and enjoyable.
    </p>
    <p class="mt-6 leading-relaxed">
      Outside of work, I enjoy exploring nature, reading social science literature, having thoughtful conversations over coffee, and contributing to community development.
    </p>
  </div>
</Section>
