---
/**
 * About Section Component
 * 
 * Clean biographical content with emphasized place names.
 */
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import RoughNotation from "./ui/RoughNotation.astro";
---

<Section id="about">
  <SectionTitle>About me</SectionTitle>
  <div class="prose prose-lg max-w-none text-muted-foreground">
    <p class="leading-relaxed">
      I'm a <RoughNotation type="underline" color="var(--foreground)" strokeWidth={2} padding={3} animate={true} scrollTrigger={true}><strong class="text-foreground">psychology researcher</strong></RoughNotation> interested in how people think, behave, and relate to the world around them.
    </p>
    <p class="mt-6 leading-relaxed">
      My work combines psychological measurement, research, and data analysis.
    </p>
    <p class="mt-6 leading-relaxed">
      Beyond research, I enjoy exploring nature, reading social science literature, engaging in thoughtful discussions over coffee, and contributing to community development.
    </p>
  </div>
</Section>
