---
/**
 * About Section Component
 * 
 * Clean biographical content with emphasized place names.
 */
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import RoughNotation from "./ui/RoughNotation.astro";
---

<Section id="about">
  <SectionTitle>About me</SectionTitle>
  <div class="prose prose-lg max-w-none text-muted-foreground">
    <p class="leading-relaxed">
      I am a <RoughNotation type="underline" color="var(--foreground)" strokeWidth={2} padding={3} animate={true} scrollTrigger={true}><strong class="text-foreground">researcher</strong></RoughNotation> with an interdisciplinary background in psychology, environmental research, and behavioral science. My experience spans qualitative fieldwork, quantitative analysis, psychometric assessment, and instrument adaptation, with a focus on translating behavioral insights into evidence-based research and practical solutions.
    </p>
    <p class="mt-6 leading-relaxed">
      My research interests center on <RoughNotation type="underline" color="var(--foreground)" strokeWidth={2} padding={3} animate={true} scrollTrigger={true}><strong class="text-foreground">pro-environmental behavior</strong></RoughNotation>, climate change perception, social dynamics, and the psychological factors that shape individual and collective behavior. Across academic and applied projects, I have worked with diverse communities, developed and adapted research instruments, and contributed to data-driven research and public policy.
    </p>
    <p class="mt-6 leading-relaxed">
      Beyond research, I enjoy exploring nature, reading social science literature, engaging in thoughtful discussions over coffee, and contributing to community development.
    </p>
  </div>
</Section>
