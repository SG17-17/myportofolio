---
/**
 * About Section Component
 * 
 * Clean biographical content with emphasized place names.
 */
import Section from "./Section.astro";
import SectionTitle from "./SectionTitle.astro";
import RoughNotation from "./ui/RoughNotation.astro";
---

<Section id="about">
  <SectionTitle>About me</SectionTitle>
  <div class="prose prose-lg max-w-none text-muted-foreground">
    <p class="leading-relaxed">
      At <RoughNotation type="underline" color="var(--foreground)" strokeWidth={2} padding={3} animate={true} scrollTrigger={true}><strong class="text-foreground">Universitas Padjadjaran</strong></RoughNotation>, I am advancing my research in social and environmental psychology. My background spans multiple disciplines—from conducting qualitative field surveys across diverse communities to statistical modeling and adapting <RoughNotation type="underline" color="var(--foreground)" strokeWidth={2} padding={3} animate={true} scrollTrigger={true}><strong class="text-foreground">psychometric instruments</strong></RoughNotation> for evidence-based research and public policy.
    </p>
    <p class="mt-6 leading-relaxed">
      My <RoughNotation type="underline" color="var(--foreground)" strokeWidth={2} padding={3} animate={true} scrollTrigger={true}><strong class="text-foreground">Master's degree</strong></RoughNotation> focuses on the psychological aspects underlying pro-environmental behavior, climate change perception, and social dynamics. At <strong class="text-foreground">Universitas Muria Kudus</strong>, I built my foundational knowledge in psychology and behavioral assessments.
    </p>
    <p class="mt-6 leading-relaxed">
      When I am not in "work mode," I enjoy exploring nature, reading books on social sciences, having engaging discussions over a good cup of coffee, and participating in community development.
    </p>
  </div>
</Section>
