---
/**
 * Skills Section Component
 * 
 * Grouped competencies using the portfolio's existing typography and rules.
 */
import profile from '../data/profile.json';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
---

<Section id="skills">
  <SectionTitle>Skills</SectionTitle>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8">
    {profile.skills.map((skill) => (
      <div class="skill-group">
        <h3>{skill.label}</h3>
        <p>{skill.text}</p>
      </div>
    ))}
  </div>
</Section>

<style>
  .skill-group { border-top: 1px solid var(--border); padding-top: 1.25rem; }
  .skill-group h3 { font-size: 1.125rem; line-height: 1.4; font-weight: 700; margin-bottom: .75rem; }
  .skill-group p { color: var(--muted-foreground); font-size: 1rem; line-height: 1.75; }
</style>
