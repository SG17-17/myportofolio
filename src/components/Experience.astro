---
import profile from '../data/profile.json';
import Section from './Section.astro';
import SectionTitle from './SectionTitle.astro';
---

<Section id="experience">
  <SectionTitle>Experience</SectionTitle>
  <div class="experience-list">
    {profile.experience.map((item, index) => (
      <details class="experience-entry" open={index < 2}>
        <summary>
          <span class="entry-heading">
            <span class="entry-title">{item.title}</span>
            <span class="entry-period">{item.period}</span>
          </span>
          <span class="entry-toggle" aria-hidden="true"></span>
        </summary>
        <div class="entry-body">
          {item.context.filter(line => line !== item.period).map(line => <p class="entry-context">{line}</p>)}
          <ul>{item.bullets.map(line => <li>{line}</li>)}</ul>
          {item.evidence && <a class="evidence-link" href={item.evidence.url} target="_blank" rel="noopener noreferrer">View {item.evidence.label}</a>}
        </div>
      </details>
    ))}
  </div>
</Section>

<style>
  .experience-list { border-top: 2px solid var(--foreground); }
  .experience-entry { border-bottom: 1px solid var(--foreground); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.5rem 0; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:focus-visible { outline: 2px solid var(--foreground); outline-offset: 6px; }
  .entry-heading { display: grid; gap: .5rem; }
  .entry-title { font-family: 'Bitter', Georgia, serif; font-weight: 700; font-size: 1.25rem; line-height: 1.4; }
  .entry-period { font-size: .875rem; color: var(--muted-foreground); }
  .entry-toggle { flex: 0 0 1rem; width: 1rem; height: 1rem; position: relative; }
  .entry-toggle::before, .entry-toggle::after { content: ''; position: absolute; background: var(--foreground); }
  .entry-toggle::before { width: 1rem; height: 2px; top: calc(50% - 1px); }
  .entry-toggle::after { height: 1rem; width: 2px; left: calc(50% - 1px); }
  details[open] .entry-toggle::after { display: none; }
  .entry-body { padding: 0 0 1.75rem; color: var(--muted-foreground); font-size: 1rem; line-height: 1.75; }
  .entry-context { margin-bottom: .25rem; }
  ul { list-style: disc; padding-left: 1.25rem; margin-top: 1rem; }
  li + li { margin-top: .625rem; }
  .evidence-link { display: inline-block; margin-top: 1rem; color: var(--foreground); text-decoration: underline; text-underline-offset: 4px; }
</style>
