---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../data/constants';
import profile from '../data/profile.json';
import '../styles/global.css';
---

<Layout title={`CV — ${SITE_CONFIG.name}`}>
  <main class="cv-page">
    <header class="cv-header">
      <a class="back-link" href="/">Back to portfolio</a>
      <h1>{SITE_CONFIG.name}</h1>
      <p class="cv-headline">{SITE_CONFIG.title}</p>
      <div class="cv-contact">
        <span>Jepara, Central Java, Indonesia</span>
        <a href="tel:+6281818170100">+62 818-1817-0100</a>
        <a href={`mailto:${SITE_CONFIG.email}`}>{SITE_CONFIG.email}</a>
        <a href="https://www.linkedin.com/in/niammakhali/">LinkedIn</a>
      </div>
      <a class="download-link btn-stipple-light" href="/CV_NIAM_MAKHALI.pdf" download="Muhammad_Niam_Makhali_CV.pdf">Download CV (PDF)</a>
    </header>
    <section aria-labelledby="summary-title">
      <h2 id="summary-title">Professional Summary</h2>
      <p>{profile.summary}</p>
    </section>
    <section aria-labelledby="experience-title">
      <h2 id="experience-title">Professional Experience</h2>
      {profile.experience.map(item => (
        <article>
          <h3>{item.title}</h3>
          {item.context.map(line => <p class="metadata">{line}</p>)}
          <ul>{item.bullets.map(line => <li>{line}</li>)}</ul>
          {item.evidence && <a href={item.evidence.url}>View {item.evidence.label}</a>}
        </article>
      ))}
    </section>
    <section aria-labelledby="project-title">
      <h2 id="project-title">Independent Project</h2>
      <h3>{profile.independentProject.title}</h3>
      <p class="metadata">{profile.independentProject.context}</p>
      <ul>{profile.independentProject.bullets.map(line => <li>{line}</li>)}</ul>
      <a href={profile.independentProject.url}>View ToleMetri</a>
    </section>
    <section aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      {profile.education.map(line => line.includes('Degree') ? <h3>{line}</h3> : <p>{line}</p>)}
    </section>
    <section aria-labelledby="skills-title">
      <h2 id="skills-title">Skills &amp; Competencies</h2>
      {profile.skills.map(item => <p><strong>{item.label}:</strong> {item.text}</p>)}
    </section>
    <section aria-labelledby="languages-title">
      <h2 id="languages-title">Languages</h2>
      <p>{profile.languages}</p>
    </section>
  </main>
</Layout>

<style>
  .cv-page { max-width: 56rem; margin: 0 auto; padding: 7rem 1.5rem 5rem; line-height: 1.75; font-size: 1rem; }
  .cv-header { margin-bottom: 3rem; }
  .back-link { display: inline-block; margin-bottom: 2rem; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; line-height: 1.25; }
  .cv-headline { font-size: 1.25rem; font-weight: 600; margin: 1rem 0; color: var(--foreground); }
  .cv-contact { display: flex; flex-wrap: wrap; column-gap: 1.5rem; row-gap: .5rem; font-size: .875rem; color: var(--muted-foreground); }
  a { color: var(--foreground); text-decoration: underline; text-underline-offset: 4px; overflow-wrap: anywhere; }
  .download-link { display: inline-block; margin-top: 1.5rem; padding: .75rem 1.25rem; background: var(--foreground); color: var(--background); text-decoration: none; font-weight: 600; }
  section { margin-top: 2.5rem; }
  h2 { font-size: 1.5rem; font-weight: 700; border-bottom: 1px solid var(--foreground); padding-bottom: .625rem; margin-bottom: 1.5rem; line-height: 1.4; }
  h3 { font-size: 1.125rem; font-weight: 700; margin: 1.5rem 0 .5rem; line-height: 1.5; }
  p, ul { color: var(--muted-foreground); }
  p + p { margin-top: .625rem; }
  .metadata { font-size: .875rem; }
  ul { list-style: disc; padding-left: 1.25rem; margin: 1rem 0; }
  li + li { margin-top: .5rem; }
  @media print {
    .cv-page { padding: 0; font-size: 10pt; max-width: none; }
    .back-link, .download-link { display: none; }
    h1 { font-size: 22pt; }
    h2 { font-size: 13pt; break-after: avoid; }
    h3 { break-after: avoid; }
    li { break-inside: avoid; }
  }
</style>
